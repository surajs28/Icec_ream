  "narrative": {
    "northStar": "The Happy Scoop Stage",
    "overview": "Berry red sets an appetising photographic stage; cream actions and heavy, close-set headings keep Mr Gelato immediate. Warm cream and cocoa support the reading surfaces, while pistachio and strawberry remain flavour accents. The approved hero direction replaces the earlier floating cone composition.\n\nGenerous section separation surrounds compact navigation and controls. Product depth responds gently to a fine pointer; coverflow exploration and the concept pint remain optional enhancements to a frontend-only sample.",
    "keyCharacteristics": [
      "Berry-red photography with cream foreground actions.",
      "Heavy Jakarta headings with restrained Inter reading text.",
      "Cream information surfaces, pill controls and rounded product imagery.",
      "Midnight coverflow with soft photographic depth.",
      "Optional motion with reduced-motion and global pause controls."
    ],
    "rules": [
      {
        "name": "The Cocoa Structure Rule",
        "body": "Keep cocoa text and outlines as the default structure on pale surfaces; use cream foregrounds on berry and midnight grounds.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Jakarta for brand and headings; use Inter for reading, navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Soft Stage Rule",
        "body": "Keep product depth diffuse and information surfaces quiet; use the existing frosted overlays where they support labels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep cocoa structure on pale surfaces and cream foregrounds on berry or midnight.",
      "Do keep Jakarta headings and Inter reading/control text.",
      "Do preserve keyboard focus, pressed/checked semantics and reduced-motion behavior.",
      "Do keep the homepage coverflow directly after the hero and retain the full menu collection."
    ],
    "donts": [
      "Don't present illustrative imagery or location previews as verified brand evidence.",
      "Don't make optional motion a requirement for reading or completing controls.",
      "Don't turn tiny annotations or decorative eyebrows into default reading or heading roles.\r"
    ]
  }
}
