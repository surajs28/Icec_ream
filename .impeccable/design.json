  "narrative": {
    "northStar": "The Welcoming Scoop Café",
    "overview": "Ivory connects the café reading surfaces; chocolate provides structure and wine berry accents its actions. Bright food photography carries appetite, with cream text over the berry hero and plain ivory caption bands beneath signature photography. The temporary Mr Gelato wordmark retains the locally shipped Jakarta display face and Inter reading face.\n\nGenerous section spacing surrounds compact pill controls, warm outlines and softly lifted photographic cards. Optional pointer and coverflow motion supports exploration without becoming a requirement for reading or navigation.",
    "keyCharacteristics": [
      "Ivory surfaces with chocolate text and wine-berry actions.",
      "Heavy Jakarta headings with Inter reading and controls.",
      "Bright illustrative photography and separate pale caption bands.",
      "Pill controls, warm boundaries and diffuse product depth.",
      "Optional motion with reduced-motion and pause behavior."
    ],
    "rules": [
      {
        "name": "The Ivory Continuity Rule",
        "body": "Keep reading sections on ivory; let photography and berry actions carry the colour changes.",
        "section": "colors"
      },
      {
        "name": "The Chocolate Structure Rule",
        "body": "Keep chocolate text and outlines as the default structure on pale surfaces; use cream foregrounds on berry and chocolate grounds.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Jakarta for brand and headings; use Inter for reading, navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Soft Stage Rule",
        "body": "Keep product depth diffuse and information surfaces quiet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep ivory reading surfaces, chocolate structure and wine-berry actions.",
      "**Do** keep Jakarta headings and Inter reading/control text.",
      "**Do** preserve keyboard focus, pressed/checked semantics and reduced-motion behavior.",
      "**Do** use separate pale caption bands beneath signature photography."
    ],
    "donts": [
      "**Don't** present illustrative photography or location previews as verified brand evidence.",
      "**Don't** make optional motion a requirement for reading or completing controls.",
      "**Don't** introduce green UI fields or dark photographic card overlays into the ivory direction.",
      "**Don't** turn tiny annotations or decorative eyebrows into default reading or heading roles."
    ]
  }
